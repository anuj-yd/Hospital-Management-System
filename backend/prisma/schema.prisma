generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────

enum Role {
  ADMIN
  FRONT_DESK
  CLINICIAN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitStatus {
  OPEN
  CLOSED
}

enum DiagnosticReportStatus {
  ORDERED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ─── Models ──────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  doctor               Doctor?
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  createdAppointments  Appointment[]        @relation("UserCreatedAppointments")
  appointmentHistories AppointmentHistory[] @relation("UserAppointmentHistories")
  prescriptions        Prescription[]       @relation("UserPrescriptions")
  diagnosticReports    DiagnosticReport[]   @relation("UserDiagnosticReports")
  invoices             Invoice[]            @relation("UserInvoices")
  payments             Payment[]            @relation("UserPayments")
  idempotencyKeys      IdempotencyKey[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  doctors Doctor[]
}

model Doctor {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @unique @db.Uuid
  departmentId    String   @db.Uuid
  specialization  String
  licenseNumber   String   @unique
  slotDurationMin Int      @default(30)
  consultationFee Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  department   Department       @relation(fields: [departmentId], references: [id])
  schedules    DoctorSchedule[]
  appointments Appointment[]
  visits       Visit[]

  @@index([departmentId])
}

model DoctorSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @db.Uuid
  dayOfWeek Int // 0-6 (0=Sunday ... 6=Saturday)
  startTime String   @db.VarChar(5) // "HH:mm"
  endTime   String   @db.VarChar(5) // "HH:mm"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId])
}

model Patient {
  id                    String   @id @default(uuid()) @db.Uuid
  mrn                   String   @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime @db.Date
  gender                Gender
  phone                 String
  email                 String?
  address               String?  @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  appointments Appointment[]
  visits       Visit[]
  invoices     Invoice[]

  @@index([lastName])
  @@index([phone])
  @@index([mrn])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  patientId       String            @db.Uuid
  doctorId        String            @db.Uuid
  startTime       DateTime          @db.Timestamptz
  endTime         DateTime          @db.Timestamptz
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?           @db.Text
  cancelReason    String?           @db.Text
  rescheduleCount Int               @default(0)
  createdById     String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  patient   Patient              @relation(fields: [patientId], references: [id])
  doctor    Doctor               @relation(fields: [doctorId], references: [id])
  createdBy User?                @relation("UserCreatedAppointments", fields: [createdById], references: [id], onDelete: SetNull)
  visit     Visit?
  histories AppointmentHistory[]

  @@index([doctorId, startTime])
  @@index([patientId, startTime])
  @@index([status])
}

model AppointmentHistory {
  id            String             @id @default(uuid()) @db.Uuid
  appointmentId String             @db.Uuid
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  oldStartTime  DateTime?          @db.Timestamptz
  newStartTime  DateTime?          @db.Timestamptz
  changedById   String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("UserAppointmentHistories", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

model Visit {
  id             String      @id @default(uuid()) @db.Uuid
  appointmentId  String      @unique @db.Uuid
  patientId      String      @db.Uuid
  doctorId       String      @db.Uuid
  status         VisitStatus @default(OPEN)
  checkInAt      DateTime?   @db.Timestamptz
  closedAt       DateTime?   @db.Timestamptz
  chiefComplaint String?     @db.Text
  clinicalNotes  String?     @db.Text
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  appointment        Appointment        @relation(fields: [appointmentId], references: [id])
  patient            Patient            @relation(fields: [patientId], references: [id])
  doctor             Doctor             @relation(fields: [doctorId], references: [id])
  prescriptions      Prescription[]
  diagnosticReports  DiagnosticReport[]
  invoices           Invoice[]

  @@index([patientId])
  @@index([doctorId])
}

model Prescription {
  id             String   @id @default(uuid()) @db.Uuid
  visitId        String   @db.Uuid
  medication     String
  dosage         String
  frequency      String
  durationDays   Int
  instructions   String?  @db.Text
  prescribedById String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  visit        Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  prescribedBy User? @relation("UserPrescriptions", fields: [prescribedById], references: [id], onDelete: SetNull)

  @@index([visitId])
}

model DiagnosticReport {
  id            String                 @id @default(uuid()) @db.Uuid
  visitId       String                 @db.Uuid
  reportType    String
  status        DiagnosticReportStatus @default(ORDERED)
  orderedAt     DateTime               @default(now()) @db.Timestamptz
  completedAt   DateTime?              @db.Timestamptz
  resultSummary String?                @db.Text
  fileReference String? // metadata only, no file upload
  orderedById   String?                @db.Uuid
  createdAt     DateTime               @default(now()) @db.Timestamptz
  updatedAt     DateTime               @updatedAt @db.Timestamptz

  visit     Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  orderedBy User? @relation("UserDiagnosticReports", fields: [orderedById], references: [id], onDelete: SetNull)

  @@index([visitId])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique
  patientId      String        @db.Uuid
  visitId        String?       @db.Uuid
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt       DateTime?     @db.Timestamptz
  dueDate        DateTime?     @db.Timestamptz
  voidedAt       DateTime?     @db.Timestamptz
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz

  patient   Patient       @relation(fields: [patientId], references: [id])
  visit     Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("UserInvoices", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]

  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  invoiceId        String        @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  gatewayReference String?
  idempotencyKey   String?       @unique
  createdById      String?       @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User?   @relation("UserPayments", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String
  userId         String   @db.Uuid
  method         String   @db.VarChar(10)
  path           String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  userRole  String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ip        String?
  userAgent String?
  requestId String?
  createdAt DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}
