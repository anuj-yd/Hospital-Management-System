# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://hms_user:hms_password@localhost:5432/hms_db?schema=public

# ─── Test database (separate from dev) ────────────────────────
DATABASE_URL_TEST=postgresql://hms_test_user:hms_test_password@localhost:5433/hms_test_db?schema=public

# ─── Auth / JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── Clinic timezone ─────────────────────────────────────────
CLINIC_TZ=Asia/Kolkata

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
