            }
          }
        }
      ]
    },
    {
      "name": "5. User Administration & Audit Logs",
      "item": [
        {
          "name": "List Staff Users (ADMIN only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
